{
  "name": "nativefragments.org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-app.mjs",
    "dev": "wrangler dev --live-reload",
    "deploy": "NODE_ENV=production wrangler deploy",
    "check": "npm run build && node --check worker.js && find site client -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "@nativefragments/core": "*",
    "@nativefragments/lit": "*",
    "lit": "3.3.3"
  }
}
