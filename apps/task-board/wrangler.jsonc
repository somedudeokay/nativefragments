{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nativefragments-task-board",
  "main": ".nativefragments/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat", "enable_request_signal"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "build": {
    "command": "node ../../scripts/build-app.mjs",
    "watch_dir": [
      "worker.js",
      "site",
      "client"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nativefragments-task-board",
      "database_id": "014963b7-a849-4150-8e68-505b17691a9c",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "task-board.nativefragments.org",
      "custom_domain": true
    }
  ]
}
