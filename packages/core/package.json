{
  "name": "@nativefragments/core",
  "version": "0.8.0",
  "description": "Explicit HTML routing, fragments, and streaming for fast web applications.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./cloudflare": {
      "types": "./types/src/cloudflare/index.d.ts",
      "default": "./src/cloudflare/index.js"
    },
    "./server": {
      "types": "./types/src/server/index.d.ts",
      "default": "./src/server/index.js"
    },
    "./client/router.js": {
      "types": "./types/client/router.d.ts",
      "default": "./client/router.js"
    },
    "./client/worker.js": {
      "types": "./types/client/worker.d.ts",
      "default": "./client/worker.js"
    }
  },
  "typesVersions": {
    "*": {
      "cloudflare": [
        "./types/src/cloudflare/index.d.ts"
      ],
      "server": [
        "./types/src/server/index.d.ts"
      ],
      "client/router.js": [
        "./types/client/router.d.ts"
      ],
      "client/worker.js": [
        "./types/client/worker.d.ts"
      ],
      "*": [
        "./types/src/index.d.ts"
      ]
    }
  },
  "files": [
    "src",
    "client",
    "types",
    "docs",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somedudeokay/nativefragments.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/somedudeokay/nativefragments/issues"
  },
  "homepage": "https://nativefragments.org",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "find src client -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test",
    "types": "tsc -p tsconfig.types.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && npm run types && changeset publish"
  },
  "keywords": [
    "web-components",
    "cloudflare-workers",
    "html-streaming",
    "fragments",
    "server-rendering",
    "web-applications"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "typescript": "^6.0.3"
  }
}
