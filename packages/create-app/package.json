{
  "name": "@nativefragments/create-app",
  "version": "0.7.0",
  "description": "Create a fast, explicit HTML application with Native Fragments.",
  "type": "module",
  "bin": {
    "create-app": "bin/create-app.js"
  },
  "files": [
    "bin",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "build.js",
    "http.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somedudeokay/nativefragments.git",
    "directory": "packages/create-app"
  },
  "homepage": "https://nativefragments.org/docs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check bin/create-app.js && find templates -name '*.js' -print0 | xargs -0 -n1 node --check && node --check build.js && node --check http.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && changeset publish"
  },
  "keywords": [
    "nativefragments",
    "create",
    "cloudflare-workers",
    "html-streaming"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0"
  },
  "exports": {
    "./build": "./build.js",
    "./http": "./http.js"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  }
}
