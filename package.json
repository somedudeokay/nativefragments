{
  "name": "nativefragments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Native Fragments monorepo: framework packages and websites.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run types -w packages/core && changeset publish",
    "dev:web": "npm run dev -w apps/web",
    "deploy:web": "npm run deploy -w apps/web",
    "dev:docs": "npm run dev -w apps/docs",
    "deploy:docs": "npm run deploy -w apps/docs",
    "test:types": "npm run types -w packages/core && tsc -p tests/types/tsconfig.json",
    "test:browser": "playwright test",
    "test:packed": "node scripts/test-packed.mjs",
    "eval:streaming": "playwright test streaming.spec.js --repeat-each=5",
    "verify": "npm run check && npm test && npm run test:runtime && npm run test:types && npm run test:browser && npm run test:packed",
    "test:runtime": "node --test tests/runtime/*.test.js"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20260926.0-alpha",
    "wrangler": "^4.143.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somedudeokay/nativefragments.git"
  },
  "license": "MIT",
  "overrides": {
    "undici": "^7.29.1"
  }
}
